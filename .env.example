# Shop backend. Copy to .env locally; these are Vercel Environment Variables in production.

# Postgres (Vercel → Storage → Neon sets this automatically on deploy).
# Empty locally = SQLite at .data/9inetailss.db.
DATABASE_URL=

# /admin login.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Stripe secret key (sk_test_… locally and in Preview, sk_live_… in Production).
# Checkout is disabled until this exists.
STRIPE_SECRET_KEY=

# Signing secret (whsec_…) of the webhook endpoint pointing at /api/stripe/webhook.
# Without it, an order is only marked paid when the buyer returns to the site.
STRIPE_WEBHOOK_SECRET=

# Only needed if the shop API is served from a different domain than the site.
PUBLIC_SITE_ORIGINS=
